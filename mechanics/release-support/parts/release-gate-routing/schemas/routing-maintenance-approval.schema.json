{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8Dionysus/aoa-routing/blob/main/mechanics/release-support/parts/release-gate-routing/schemas/routing-maintenance-approval.schema.json",
  "title": "aoa-routing reviewed retained-source maintenance approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "change_class",
    "approved_on",
    "approval",
    "scope",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {
      "const": "aoa_routing_maintenance_approval_v1"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^AOA-RT-MA-[0-9]{4}$"
    },
    "change_class": {
      "enum": [
        "compatibility",
        "security",
        "rollback",
        "deprecation"
      ]
    },
    "approved_on": {
      "type": "string",
      "format": "date"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "approval_ref"
      ],
      "properties": {
        "status": {
          "const": "approved"
        },
        "approved_by": {
          "type": "string",
          "minLength": 2
        },
        "approval_ref": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintenance_base_ref",
        "retained_source_blobs"
      ],
      "properties": {
        "maintenance_base_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "retained_source_blobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "git_blob_id"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "git_blob_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              }
            }
          }
        }
      }
    },
    "claim_limit": {
      "type": "string",
      "minLength": 40
    }
  }
}
